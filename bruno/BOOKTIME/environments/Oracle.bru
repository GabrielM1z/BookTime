vars {
  base_keycloak_url: {{base_url}}:8080/realms/booktime
  client_secret: {{process.env.KEYCLOAK_CLIENT_SECRET_SERVER_ORACLE}}
  username: test@booktime.fr
  base_book_url: {{base_url}}:8082/books
  base_user_url: {{base_url}}:8082/users
  base_news_url: {{base_url}}:8082/news
}
vars:secret [
  password,
  base_url,
  access_token,
  refresh_token
]
