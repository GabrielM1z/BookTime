meta {
  name: Update state by bookId
  type: http
  seq: 5
}

put {
  url: {{base_book_url}}/states/:bookId
  body: json
  auth: bearer
}

params:path {
  bookId: 9782701178165
}

headers {
  bookId: f18251e2-0134-46b8-a09b-8362b023764a
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
      "state": "ToRead",
      "read_count": 200,
      "progression": 20,
      "last_read_date": "1983-03-03",
      "id_book": "9782355221347",
      "is_available": true,
      "comment": "finalement jaime bien",
      "rate": 4
  }
}

tests {
  test("Successful POST request", function () {
      expect(res.getStatus()).to.be.oneOf([200, 201]);
  });
  
}

docs {
  This is a POST request, submitting data to an API via the request body. This request submits JSON data, and the data is reflected in the response.
  
  A successful POST request typically returns a `200 OK` or `201 Created` response code.
}
