meta {
  name: Get user by id
  type: http
  seq: 2
}

get {
  url: {{base_url}}/api/users/user/:id
  body: none
  auth: bearer
}

params:path {
  id: 300ce717-9000-421b-86d6-b8a378ebcf88
}

