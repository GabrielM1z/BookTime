meta {
  name: Create an author
  type: http
  seq: 4
}

post {
  url: {{base_book_url}}/authors
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
      "first_name": "J.K.",
      "last_name": "Rowling",
      "description": "LA PUTE la"
  }
  
}

tests {
